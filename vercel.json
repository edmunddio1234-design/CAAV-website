{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/dashboard(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/immersion-in-motion",
      "destination": "https://immersion-in-motion.vercel.app/",
      "permanent": false
    },
    {
      "source": "/immersion-in-motion/:path*",
      "destination": "https://immersion-in-motion.vercel.app/:path*",
      "permanent": false
    },
    {
      "source": "/board",
      "destination": "/team",
      "permanent": true
    },
    {
      "source": "/board/",
      "destination": "/team",
      "permanent": true
    },
    {
      "source": "/conferences",
      "destination": "/initiatives",
      "permanent": true
    },
    {
      "source": "/conferences/",
      "destination": "/initiatives",
      "permanent": true
    },
    {
      "source": "/membership",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/membership/",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/projects-home",
      "destination": "/projects",
      "permanent": true
    },
    {
      "source": "/equipment",
      "destination": "/about#equipment",
      "permanent": true
    },
    {
      "source": "/publications",
      "destination": "/initiatives#publications",
      "permanent": true
    },
    {
      "source": "/service-request",
      "destination": "/request-services",
      "permanent": true
    },
    {
      "source": "/category/all-products",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/category/:slug*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/notifications",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/my-subscriptions",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/booking-calendar/cave-tour",
      "destination": "/book-a-tour",
      "permanent": true
    },
    {
      "source": "/booking-calendar/:slug*",
      "destination": "/book-a-tour",
      "permanent": true
    },
    {
      "source": "/service-page/2026-xr-summer-camp-registration",
      "destination": "/initiatives#camps",
      "permanent": true
    },
    {
      "source": "/service-page/:slug*",
      "destination": "/request-services",
      "permanent": true
    },
    {
      "source": "/blog-feed.xml",
      "destination": "/news",
      "permanent": true
    },
    {
      "source": "/projects/ntia",
      "destination": "/projects#suradd",
      "permanent": true
    },
    {
      "source": "/projects/oph",
      "destination": "/projects#oph",
      "permanent": true
    },
    {
      "source": "/projects/iclert",
      "destination": "/projects#iclert",
      "permanent": true
    },
    {
      "source": "/projects/enhancing-additive-manufacturing-education-with-cybersecurity-and-virtual-reality",
      "destination": "/projects#am-cyber-vr",
      "permanent": true
    }
  ]
}
